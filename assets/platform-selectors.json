        ".ud__picker",
        ".ud__form__item",
        ".bitable-form-item",
        ".ud__tree"
      ],
      "option_container_selector": ".ud__select__dropdown:not(.ud__select__dropdown-hidden)",
      "option_selector": ".ud__select__list__item",
      "trigger_selector": ".ud__select, .ud__picker-dateInput, .throne-biz-date-range-picker-input",
      "search_input_selector": "input",
      "display_value_selector": ".ud__select__selector__text, .ud__select__selection",
      "date_input_ancestor": ".ud__picker-dateInput",
      "date_range_ancestor": ".throne-biz-date-range-picker-input",
      "date_preset": "feishu",
      "tree": {
        "wrapper": ".ud__tree, .ud__tree__list",
        "node": ".ud__tree__node",
        "title": ".ud__tree__node__label",
        "switcher": ".ud__expandButton, .ud__tree__node__expandIcon"
      },
      "layout_preset": "feishu"
    }
  },
