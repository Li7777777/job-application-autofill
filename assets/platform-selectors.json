  "date_granularity_hints": {
    "day": [
      "yyyy[-/.年]?mm[-/.月]?dd",
      "yyyymmdd",
      "年月日",
      "具体日期"
    ],
    "month": [
      "yyyy[-/.年]?mm(?![-/.月]?dd)",
      "yyyymm",
      "年\\s*月",
      "年月"
    ],
    "year": [
      "yyyy(?![-/.年]?mm)",
      "年份"
    ]
  },
  "date_granularity_note": "从 placeholder/name/id/title 用这些正则猜「组件支持到哪一级」(day>month>year，按顺序命中)；故意不看 label（「出生日期」这种标签不说明控件粒度）。猜不出就留空，由填充器自适应：只会丢精度并如实上报，绝不会凭空补精度。"
}